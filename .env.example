MAX_FILES_IN_ARCHIVE=5000
MAX_NESTING_DEPTH=3
MAX_SINGLE_FILE_MB=50
FILE_RETENTION_DAYS=7
FILE_CLEANUP_INTERVAL_MINUTES=60
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
