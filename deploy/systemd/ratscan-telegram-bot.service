[Unit]
Description=RatScan Telegram Bot
Wants=network-online.target
After=network-online.target ratscan.service

[Service]
Type=simple
User=ratscan
Group=ratscan
WorkingDirectory=/opt/ratscan
EnvironmentFile=/etc/ratscan/ratscan.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ratscan/telegram-venv/bin/python -m telegram_bot.bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
