[Unit]
Description=RatScan Discord bot
Wants=network-online.target
After=network-online.target postgresql.service ratscan.service
Requires=ratscan.service

[Service]
Type=simple
User=ratscan
Group=ratscan
WorkingDirectory=/opt/ratscan
EnvironmentFile=/etc/ratscan/ratscan.env
ExecStart=/opt/ratscan/bin/ratscan-discord
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
